# ──────────────────────────────────────────────
# Root .gitignore  (monorepo level)
# ──────────────────────────────────────────────

# OS / Editor artefacts
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/settings.json

# Environment files (never commit real secrets)
.env
.env.*
!.env.example

# Seed / utility scripts that contain credentials
seed_test_users.js
seed_freelance_cats.js
query_cats.js

# Misc scratch files
beleqet-integration-agent-prompt.md
